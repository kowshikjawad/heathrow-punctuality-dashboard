# Copy .env.example to .env and adjust values if needed.
# Postgres connection (used by docker-compose and the pipeline)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=heathrow
POSTGRES_PASSWORD=heathrow
POSTGRES_DB=punctuality

# Postgres connection string used by the pipeline (DBAPI URL)
DATABASE_URL=postgresql+psycopg://heathrow:heathrow@localhost:5432/punctuality